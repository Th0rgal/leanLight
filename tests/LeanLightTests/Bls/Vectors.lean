namespace LeanLight.Tests.Bls.Vectors

/-- A FastAggregateVerify case (`eth_fast_aggregate_verify`, `fast_aggregate_verify`,
`verify`), hex without `0x`. -/
structure Fav where
  name : String
  pubkeys : List String
  message : String
  signature : String
  output : Bool

/-- An `eth_aggregate_pubkeys` case; `none` when the input is refused. -/
structure Agg where
  name : String
  pubkeys : List String
  output : Option String

/-- A `deserialization_G1` or `_G2` case: whether the bytes are a point of the subgroup (the identity included). -/
structure Deser where
  name : String
  bytes : String
  output : Bool

/-- A `sign` case: `[privkey]·H(message)`, compressed; `none` for a refused key. -/
structure Sign where
  name : String
  privkey : String
  message : String
  output : Option String

/-- A `hash_to_G2` case of bls12-381-tests (RFC 9380's DST): `P = (c0, c1)`. -/
structure H2G where
  name : String
  msg : String
  px : String × String
  py : String × String

/-- An RFC 9380 J.10.1 case, each `Fp2` value `(c0, c1)`. -/
structure Rfc where
  msg : String
  px : String × String
  py : String × String
  u0 : String × String
  u1 : String × String
  q0x : String × String
  q0y : String × String
  q1x : String × String
  q1y : String × String

